APP_PORT=8080

POSTGRES_DB=dfir
POSTGRES_USER=dfir
POSTGRES_PASSWORD=replace-with-a-long-database-password

DATABASE_URL=postgresql+psycopg://dfir:replace-with-a-long-database-password@db:5432/dfir

JWT_SECRET_KEY=replace-with-at-least-64-random-characters-before-production

CORS_ORIGINS=http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_CIDRS=172.16.0.0/12

HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000

EVIDENCE_MAX_UPLOAD_BYTES=104857600
