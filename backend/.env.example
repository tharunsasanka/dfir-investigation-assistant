APP_NAME=DFIR Investigation Assistant API
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://dfir:dfir@db:5432/dfir

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173

MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

EVIDENCE_STORAGE_ROOT=/app/evidence_storage
EVIDENCE_MAX_UPLOAD_BYTES=104857600

AI_LOCAL_ENABLED=false
AI_LOCAL_PROVIDER_NAME=ollama
AI_LOCAL_BASE_URL=http://host.docker.internal:11434
AI_LOCAL_MODEL=
AI_LOCAL_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,ollama
AI_LOCAL_TIMEOUT_SECONDS=60
AI_LOCAL_CONNECT_TIMEOUT_SECONDS=5
AI_LOCAL_MAX_PROMPT_CHARS=30000
AI_LOCAL_MAX_RESPONSE_BYTES=262144
AI_LOCAL_TEMPERATURE=0.1
AI_LOCAL_FALLBACK_TO_DETERMINISTIC=true